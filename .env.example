APP_NAME="Stock AI"
APP_ENV="development"
WEB_AUTH_ENABLED=false
SUPABASE_URL=""
# Server-only secret, generated securely; never include it in /ui/config.js.
AWS_ORIGIN_SECRET=""
# Optional exact local origins, JSON array. Empty for production and previews.
WEB_CORS_ORIGINS=[]
JOBS_ENABLED=false
JOB_FILES_DIR="/var/lib/stock-ai/jobs"
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20
JOB_RETENTION_DAYS=30
DATABASE_URL="postgresql+psycopg://stock_ai:stock_ai@localhost:5432/stock_ai"
DEFAULT_BUSINESS_ID="demo-business"
KAPSO_API_KEY=""
KAPSO_WEBHOOK_SECRET=""
KAPSO_SANDBOX_PHONE_NUMBER_ID="597907523413541"
INTERNAL_API_TOKEN=""
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
LLM_ENABLED=false
LLM_PROVIDER="openai"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_DOCUMENT_MODEL="gpt-6-luna"
LLM_TIMEOUT_SECONDS=10
DOCUMENT_EXTRACTION_CHUNK_SIZE=2
DOCUMENT_EXTRACTION_CHUNK_WORKERS=2
DOCUMENT_EXTRACTION_RETRY_WORKERS=2
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=60
DOCUMENT_EXTRACTION_RETRY_LOW_COVERAGE=true
JEV_API_KEY=""
JEV_RECONCILIATION_MODEL="jev-1.13.0"
DOCUMENT_ANALYSIS_V2_ENABLED=true
# Page pipeline: bounded calls per document/explicit continuation; at most two continuations.
DOCUMENT_ANALYSIS_MAX_CALLS=100
DOCUMENT_ANALYSIS_TIMEOUT_SECONDS=180
DOCUMENT_ANALYSIS_MAX_METADATA_BYTES=4000000
# Reader: Luna 6 low. Identity: JEV with one or several compatible products.
OFFER_IDENTITY_ENABLED=true
OFFER_IDENTITY_PROVIDER=jev
OFFER_DECISIONS_MAX_CALLS=6
OFFER_DECISIONS_MAX_SPEND_USD=0.02
