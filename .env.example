DOCUMENT_EXTRACTION_CHUNK_SIZE=2
DOCUMENT_EXTRACTION_CHUNK_WORKERS=2
DOCUMENT_EXTRACTION_RETRY_WORKERS=2
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=60
DOCUMENT_EXTRACTION_RETRY_LOW_COVERAGE=true
JEV_API_KEY=""
