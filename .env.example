APP_NAME="Stock AI"
APP_ENV="development"
DATABASE_URL="postgresql+psycopg://stock_ai:stock_ai@localhost:5432/stock_ai"
DEFAULT_BUSINESS_ID="demo-business"
KAPSO_API_KEY=""
KAPSO_WEBHOOK_SECRET=""
KAPSO_SANDBOX_PHONE_NUMBER_ID="597907523413541"
INTERNAL_API_TOKEN=""
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
LLM_ENABLED=false
LLM_PROVIDER="openai"
GEMINI_API_KEY=""
